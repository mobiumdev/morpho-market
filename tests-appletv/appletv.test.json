{
  "description": "Morpho Market on an Apple TV, driven with the remote: the Fire TV test's checkout, with the presses tvOS's focus engine takes and a check after each of where focus went. tvOS types into a keyboard screen of its own: select opens it for the field with focus, fill types there, and hiding it keeps the text.",
  "app": "dev.mobium.shop.tv",
  "beforeEach": [
    {
      "dialogs": {
        "when": "Morpho Market",
        "press": "Open"
      },
      "description": "tvOS asks before a link opens the app, until Open is pressed once; the rule answers with the remote"
    },
    {
      "open_url": "mobiumshop://reset"
    },
    {
      "wait_for": {
        "target": "testid=catalogList",
        "timeout_ms": 3000
      },
      "description": "3 seconds, as on the phone: the slow-catalog bug takes 8"
    }
  ],
