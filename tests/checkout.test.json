{
  "description": "Morpho Market's checkout, against the spec's worked examples (spec/pricing-cases.json): delivery, address, payment, review, the order and its receipt. Each test starts from a reset store.",
  "app": "dev.mobium.shop",
  "beforeEach": [
    {"dialogs": {"when": "Morpho Market", "press": "Open"}, "description": "iOS asks before a link opens the app, until Open is pressed once; Android never asks"},
    {"open_url": "mobiumshop://reset"},
    {"wait_for": {"target": "testid=catalogList", "timeout_ms": 3000}}
  ],
  "tests": [
    {"name": "A: two tees and a mug, WELCOME10, standard to NY", "steps": [
      {"tap": "testid=product_tee"}, {"tap": "testid=size_M"}, {"tap": "testid=qtyPlus"}, {"tap": "testid=addToCart"},
      {"tap": "testid=backBtn"},
      {"tap": "testid=product_mug"}, {"tap": "testid=addToCart"}, {"tap": "testid=viewCart"},
      {"fill": {"target": "testid=codeField", "text": "WELCOME10"}}, {"tap": "testid=applyCode"},
      {"wait_for": {"target": "testid=sumDiscount", "condition": "text", "text": "-$6.40", "exact": true}},
      {"tap": "testid=checkoutBtn"},
      {"tap": "testid=ship_standard"},
      {"wait_for": {"target": "testid=sumShipping", "condition": "text", "text": "$5.99", "exact": true}},
      {"tap": "testid=continueDelivery"},
      {"fill": {"target": "testid=field_name", "text": "Ada Lovelace"}},
      {"fill": {"target": "testid=field_street", "text": "1 Main St"}},
      {"fill": {"target": "testid=field_city", "text": "New York"}},
      {"tap": "testid=statePicker"}, {"tap": "testid=state_NY"},
      {"fill": {"target": "testid=field_zip", "text": "10001"}},
      {"fill": {"target": "testid=field_email", "text": "ada@example.com"}},
      {"keyboard": {"key": "enter"}, "description": "the keyboard covers Continue on a long form; enter gives up focus"}, {"tap": "testid=continueBtn"},
      {"fill": {"target": "testid=field_cardNumber", "text": "4242 4242 4242 4242"}},
      {"fill": {"target": "testid=field_cardExpiry", "text": "12/30"}},
      {"fill": {"target": "testid=field_cardCvc", "text": "123"}},
      {"fill": {"target": "testid=field_cardName", "text": "Ada Lovelace"}},
      {"tap": "testid=continuePayment"},
      {"wait_for": {"target": "testid=sumTax", "condition": "text", "text": "$5.64", "exact": true}},
      {"wait_for": {"target": "testid=sumTotal", "condition": "text", "text": "$69.23", "exact": true}},
      {"tap": "testid=placeOrder"},
      {"wait_for": {"target": "testid=orderNumber", "condition": "text", "text": "Order MS-000001 placed", "exact": true}},
      {"wait_for": {"target": "testid=confirmTotal", "condition": "text", "text": "$69.23", "exact": true}},
      {"wait_for": "label=\"Cart, 0 items\""}
    ]},
    {"name": "B: MOBIUM5 takes $77.98 under the free-shipping line, CA", "steps": [
      {"tap": "testid=product_hoodie"}, {"tap": "testid=size_L"}, {"tap": "testid=addToCart"}, {"tap": "testid=backBtn"},
      {"tap": "testid=product_socks"}, {"tap": "testid=addToCart"}, {"tap": "testid=backBtn"},
      {"tap": "testid=product_magnet"}, {"tap": "testid=addToCart"}, {"tap": "testid=viewCart"},
      {"fill": {"target": "testid=codeField", "text": "MOBIUM5"}}, {"tap": "testid=applyCode"},
      {"tap": "testid=checkoutBtn"},
      {"wait_for": {"target": "testid=shipPrice_standard", "condition": "text", "text": "$5.99", "exact": true}},
      {"tap": "testid=continueDelivery"},
      {"fill": {"target": "testid=field_name", "text": "Grace Hopper"}},
      {"fill": {"target": "testid=field_street", "text": "2 Navy Way"}},
      {"fill": {"target": "testid=field_city", "text": "San Diego"}},
      {"tap": "testid=statePicker"}, {"tap": "testid=state_CA"},
      {"fill": {"target": "testid=field_zip", "text": "92101"}},
      {"fill": {"target": "testid=field_email", "text": "grace@example.com"}},
      {"keyboard": {"key": "enter"}, "description": "the keyboard covers Continue on a long form; enter gives up focus"}, {"tap": "testid=continueBtn"},
      {"fill": {"target": "testid=field_cardNumber", "text": "4242 4242 4242 4242"}},
      {"fill": {"target": "testid=field_cardExpiry", "text": "12/30"}},
      {"fill": {"target": "testid=field_cardCvc", "text": "123"}},
      {"fill": {"target": "testid=field_cardName", "text": "Grace Hopper"}},
      {"tap": "testid=continuePayment"},
      {"wait_for": {"target": "testid=sumShipping", "condition": "text", "text": "$5.99", "exact": true}},
      {"wait_for": {"target": "testid=sumTax", "condition": "text", "text": "$5.29", "exact": true}},
      {"wait_for": {"target": "testid=sumTotal", "condition": "text", "text": "$84.26", "exact": true}}
    ]},
    {"name": "C1: exactly $75.00 ships free", "steps": [
      {"tap": "testid=product_tee"}, {"tap": "testid=size_S"}, {"tap": "testid=addToCart"}, {"tap": "testid=backBtn"},
      {"tap": "testid=product_tumbler"}, {"tap": "testid=addToCart"}, {"tap": "testid=backBtn"},
      {"tap": "testid=product_tote"}, {"tap": "testid=addToCart"}, {"tap": "testid=viewCart"},
      {"wait_for": {"target": "testid=sumMerch", "condition": "text", "text": "$75.00", "exact": true}},
      {"tap": "testid=checkoutBtn"},
      {"wait_for": {"target": "testid=shipPrice_standard", "condition": "text", "text": "Free", "exact": true}},
      {"wait_for": {"target": "testid=sumShipping", "condition": "text", "text": "Free", "exact": true}}
    ]},
    {"name": "D: three tumblers, express to TX, shipping taxed", "steps": [
      {"tap": "testid=product_tumbler"}, {"tap": "testid=qtyPlus"}, {"tap": "testid=qtyPlus"}, {"tap": "testid=addToCart"},
      {"tap": "testid=viewCart"}, {"tap": "testid=checkoutBtn"},
      {"tap": "testid=ship_express"},
      {"wait_for": {"target": "testid=sumShipping", "condition": "text", "text": "$17.49", "exact": true}},
      {"tap": "testid=continueDelivery"},
      {"fill": {"target": "testid=field_name", "text": "Katherine Johnson"}},
      {"fill": {"target": "testid=field_street", "text": "3 Orbit Rd"}},
      {"fill": {"target": "testid=field_city", "text": "Houston"}},
      {"tap": "testid=statePicker"}, {"tap": "testid=state_TX"},
      {"fill": {"target": "testid=field_zip", "text": "77058"}},
      {"fill": {"target": "testid=field_email", "text": "kj@example.com"}},
      {"keyboard": {"key": "enter"}, "description": "the keyboard covers Continue on a long form; enter gives up focus"}, {"tap": "testid=continueBtn"},
      {"fill": {"target": "testid=field_cardNumber", "text": "4242 4242 4242 4242"}},
      {"fill": {"target": "testid=field_cardExpiry", "text": "12/30"}},
      {"fill": {"target": "testid=field_cardCvc", "text": "123"}},
      {"fill": {"target": "testid=field_cardName", "text": "K Johnson"}},
      {"tap": "testid=continuePayment"},
      {"wait_for": {"target": "testid=reviewDelivery", "condition": "text", "text": "Express, 1–2 days", "exact": true}},
      {"wait_for": {"target": "testid=sumTax", "condition": "text", "text": "$7.09", "exact": true}},
      {"wait_for": {"target": "testid=sumTotal", "condition": "text", "text": "$120.58", "exact": true}}
    ]},
    {"name": "K: SHIPFREE frees standard, not express", "steps": [
      {"tap": "testid=product_mug"}, {"tap": "testid=addToCart"}, {"tap": "testid=viewCart"},
      {"fill": {"target": "testid=codeField", "text": "SHIPFREE"}}, {"tap": "testid=applyCode"},
      {"tap": "testid=checkoutBtn"},
      {"wait_for": {"target": "testid=shipPrice_standard", "condition": "text", "text": "Free", "exact": true}},
      {"wait_for": {"target": "testid=shipPrice_express", "condition": "text", "text": "$14.99", "exact": true}}
    ]},
    {"name": "M: pickup asks no address and is taxed in CA", "steps": [
      {"tap": "testid=product_hoodie"}, {"tap": "testid=size_M"}, {"tap": "testid=addToCart"},
      {"tap": "testid=viewCart"}, {"tap": "testid=checkoutBtn"},
      {"tap": "testid=ship_pickup"},
      {"tap": "testid=continueDelivery"},
      {"wait_for": {"target": "testid=field_street", "condition": "hidden", "timeout_ms": 2000}},
      {"fill": {"target": "testid=field_name", "text": "Alan Turing"}},
      {"fill": {"target": "testid=field_email", "text": "alan@example.com"}},
      {"keyboard": {"key": "enter"}, "description": "the keyboard covers Continue on a long form; enter gives up focus"}, {"tap": "testid=continueBtn"},
      {"fill": {"target": "testid=field_cardNumber", "text": "4242 4242 4242 4242"}},
      {"fill": {"target": "testid=field_cardExpiry", "text": "12/30"}},
      {"fill": {"target": "testid=field_cardCvc", "text": "123"}},
      {"fill": {"target": "testid=field_cardName", "text": "Alan Turing"}},
      {"tap": "testid=continuePayment"},
      {"wait_for": {"target": "testid=sumTax", "condition": "text", "text": "$4.21", "exact": true}},
      {"wait_for": {"target": "testid=sumTotal", "condition": "text", "text": "$62.21", "exact": true}}
    ]},
    {"name": "delivery chosen stays chosen after going back from payment", "steps": [
      {"tap": "testid=product_mug"}, {"tap": "testid=addToCart"}, {"tap": "testid=viewCart"}, {"tap": "testid=checkoutBtn"},
      {"tap": "testid=ship_express"},
      {"tap": "testid=continueDelivery"},
      {"fill": {"target": "testid=field_name", "text": "Ada Lovelace"}},
      {"fill": {"target": "testid=field_street", "text": "1 Main St"}},
      {"fill": {"target": "testid=field_city", "text": "Portland"}},
      {"tap": "testid=statePicker"}, {"tap": "testid=state_OR"},
      {"fill": {"target": "testid=field_zip", "text": "97201"}},
      {"fill": {"target": "testid=field_email", "text": "ada@example.com"}},
      {"keyboard": {"key": "enter"}, "description": "the keyboard covers Continue on a long form; enter gives up focus"}, {"tap": "testid=continueBtn"},
      {"wait_for": "testid=field_cardNumber"},
      {"tap": "testid=backBtn"},
      {"keyboard": {"key": "enter"}, "description": "the keyboard covers Continue on a long form; enter gives up focus"}, {"tap": "testid=continueBtn"},
      {"fill": {"target": "testid=field_cardNumber", "text": "4242 4242 4242 4242"}},
      {"fill": {"target": "testid=field_cardExpiry", "text": "12/30"}},
      {"fill": {"target": "testid=field_cardCvc", "text": "123"}},
      {"fill": {"target": "testid=field_cardName", "text": "Ada Lovelace"}},
      {"tap": "testid=continuePayment"},
      {"wait_for": {"target": "testid=reviewDelivery", "condition": "text", "text": "Express, 1–2 days", "exact": true}}
    ]},
    {"name": "the address form says what is missing", "steps": [
      {"tap": "testid=product_mug"}, {"tap": "testid=addToCart"}, {"tap": "testid=viewCart"}, {"tap": "testid=checkoutBtn"},
      {"tap": "testid=continueDelivery"},
      {"fill": {"target": "testid=field_zip", "text": "123"}},
      {"fill": {"target": "testid=field_city", "text": "Portland"}, "description": "a ZIP's number pad has no enter key on iOS"},
      {"keyboard": {"key": "enter"}, "description": "the keyboard covers Continue on a long form; enter gives up focus"}, {"tap": "testid=continueBtn"},
      {"wait_for": {"target": "testid=error_name", "condition": "text", "text": "Enter your name.", "exact": true}},
      {"wait_for": {"target": "testid=error_state", "condition": "text", "text": "Choose a state.", "exact": true}},
      {"wait_for": {"target": "testid=error_zip", "condition": "text", "text": "Enter a 5-digit ZIP code.", "exact": true}}
    ]},
    {"name": "the declined cards are declined, and nothing is ordered", "steps": [
      {"tap": "testid=product_mug"}, {"tap": "testid=addToCart"}, {"tap": "testid=viewCart"}, {"tap": "testid=checkoutBtn"},
      {"tap": "testid=ship_pickup"}, {"tap": "testid=continueDelivery"},
      {"fill": {"target": "testid=field_name", "text": "Ada Lovelace"}},
      {"fill": {"target": "testid=field_email", "text": "ada@example.com"}},
      {"keyboard": {"key": "enter"}, "description": "the keyboard covers Continue on a long form; enter gives up focus"}, {"tap": "testid=continueBtn"},
      {"fill": {"target": "testid=field_cardNumber", "text": "4000 0000 0000 0002"}},
      {"fill": {"target": "testid=field_cardExpiry", "text": "12/30"}},
      {"fill": {"target": "testid=field_cardCvc", "text": "123"}},
      {"fill": {"target": "testid=field_cardName", "text": "Ada Lovelace"}},
      {"tap": "testid=continuePayment"},
      {"tap": "testid=placeOrder"},
      {"wait_for": {"target": "testid=paymentError", "condition": "text", "text": "Your card was declined.", "exact": true}},
      {"tap": "testid=backBtn"},
      {"fill": {"target": "testid=field_cardNumber", "text": "4000 0000 0000 9995"}},
      {"tap": "testid=continuePayment"},
      {"tap": "testid=placeOrder"},
      {"wait_for": {"target": "testid=paymentError", "condition": "text", "text": "Insufficient funds.", "exact": true}},
      {"tap": "label=Orders"},
      {"wait_for": "testid=noOrders"}
    ]},
    {"name": "the slow card is waited for, and one tap places one order", "steps": [
      {"tap": "testid=product_mug"}, {"tap": "testid=addToCart"}, {"tap": "testid=viewCart"}, {"tap": "testid=checkoutBtn"},
      {"tap": "testid=ship_pickup"}, {"tap": "testid=continueDelivery"},
      {"fill": {"target": "testid=field_name", "text": "Ada Lovelace"}},
      {"fill": {"target": "testid=field_email", "text": "ada@example.com"}},
      {"keyboard": {"key": "enter"}, "description": "the keyboard covers Continue on a long form; enter gives up focus"}, {"tap": "testid=continueBtn"},
      {"fill": {"target": "testid=field_cardNumber", "text": "4000 0000 0000 0119"}},
      {"fill": {"target": "testid=field_cardExpiry", "text": "12/30"}},
      {"fill": {"target": "testid=field_cardCvc", "text": "123"}},
      {"fill": {"target": "testid=field_cardName", "text": "Ada Lovelace"}},
      {"tap": "testid=continuePayment"},
      {"tap": "testid=placeOrder"},
      {"wait_for": {"target": "testid=placeOrder", "condition": "disabled", "timeout_ms": 2000}},
      {"wait_for": {"target": "testid=orderNumber", "condition": "text", "text": "Order MS-000001 placed", "exact": true, "timeout_ms": 15000}},
      {"tap": "label=Orders"},
      {"wait_for": {"target": "testid=orderCount", "condition": "text", "text": "1 order", "exact": true}}
    ]},
    {"name": "WELCOME10 is spent once an order uses it", "steps": [
      {"tap": "testid=product_mug"}, {"tap": "testid=addToCart"}, {"tap": "testid=viewCart"},
      {"fill": {"target": "testid=codeField", "text": "WELCOME10"}}, {"tap": "testid=applyCode"},
      {"tap": "testid=checkoutBtn"},
      {"tap": "testid=ship_pickup"}, {"tap": "testid=continueDelivery"},
      {"fill": {"target": "testid=field_name", "text": "Ada Lovelace"}},
      {"fill": {"target": "testid=field_email", "text": "ada@example.com"}},
      {"keyboard": {"key": "enter"}, "description": "the keyboard covers Continue on a long form; enter gives up focus"}, {"tap": "testid=continueBtn"},
      {"fill": {"target": "testid=field_cardNumber", "text": "4242 4242 4242 4242"}},
      {"fill": {"target": "testid=field_cardExpiry", "text": "12/30"}},
      {"fill": {"target": "testid=field_cardCvc", "text": "123"}},
      {"fill": {"target": "testid=field_cardName", "text": "Ada Lovelace"}},
      {"tap": "testid=continuePayment"},
      {"tap": "testid=placeOrder"},
      {"tap": "testid=keepShopping"},
      {"tap": "testid=product_hat"}, {"tap": "testid=addToCart"}, {"tap": "testid=viewCart"},
      {"fill": {"target": "testid=codeField", "text": "WELCOME10"}}, {"tap": "testid=applyCode"},
      {"wait_for": {"target": "testid=codeMessage", "condition": "text", "text": "That code has already been used.", "exact": true}}
    ]}
  ]
}
